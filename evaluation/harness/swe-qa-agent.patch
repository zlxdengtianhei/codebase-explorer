     def _is_blocked(self, action_name: str, arguments: Dict[str, Any]) -> bool:
         """Check if action is blocked"""
         blocklist = self.config.filter.blocklist
+
+        # E1b2 fifth change: C alone opts in to a simple absolute cbe command.
+        executable = self.config.filter.cbe_executable
+        if action_name == "bash" and executable:
+            command = arguments.get("command", "")
